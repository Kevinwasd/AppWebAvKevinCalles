<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.webServer>

        <!-- Documento predeterminado -->
        <defaultDocument>
            <files>
                <clear />
                <add value="default.asp" />
            </files>
        </defaultDocument>

        <!-- Limite del cuerpo de la peticion (30 MB) para poder subir
             archivos MP3 e imagenes desde el panel de administracion. -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="31457280" />
            </requestFiltering>
        </security>

        <!-- Detalle de errores solo para peticiones locales -->
        <httpErrors errorMode="DetailedLocalOnly" />

        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>

        <!-- NOTA: el limite propio de ASP (limits.maxRequestEntityAllowed,
             por omision 200 KB) no se define aqui para no depender de si la
             seccion <asp> esta delegada en el servidor. El script deploy.ps1
             lo configura con appcmd:
                 appcmd set config /section:asp ^
                        /limits.maxRequestEntityAllowed:31457280
             Sin ese ajuste la aplicacion funciona igual; solo se limita el
             tamano de los archivos que se pueden subir. -->
    </system.webServer>

    <system.web>
        <httpRuntime maxRequestLength="30720" executionTimeout="300" />
    </system.web>
</configuration>
